# .gitignore

# 가상환경
.venv/
.local/

# 외부 저장소
esp-csi/
wifi-csi-fall-detection/

# 데이터 & 모델
data/raw/*.csv
data/*.zip
data/raw/_archive/
data/cleaned/
data/quarantine/
data/augmented/*.csv
data/upload_log.md
model/pretrained/*.pth
model/pretrained/checkpoints/
model/pretrained/checkpoints_local_backup_*/
model/pretrained/*.pt
model/finetune/cache/
model/finetune/checkpoints/
model/finetune/checkpoints_*/
*.onnx

# Python
__pycache__/
*.pyc

# 빌드
build/

# 에디터
.vscode/
.DS_Store
Thumbs.db

# 개인용 Claude Code 메모리 (팀 공유 안 함)
CLAUDE.local.md

# 개인용 Claude Code 권한/설정 (팀 공유 안 함)
.claude/settings.local.json
.claude/settings.json

# 서버 런타임 로그
server/logs/
*.log
Get-NetUDPEndpoint
reports/

# tools/ 산출물 (augment_inspector 등) — 스크립트만 추적
tools/inspect_output/
tools/inspect_output_*/

# debug/modeling 진단 산출물 (CSV·png·npz·로그·텐서) — 스크립트만 추적
debug/modeling/diag_out/

# 사전학습 데이터셋 (폴더는 보존, 내용물만 제외)
data/alsaify-raw/*
!data/alsaify-raw/.gitkeep

# 샘플 데이터 (테스트용 zip 등, 폴더는 보존)
data/sample-data/*
!data/sample-data/.gitkeep

# 잡파일 — 커밋 금지 (실수로 리포에 들어온 것들)
# Git for Windows 설치 폴더 전체
Git/
# AI 에이전트 워크스페이스 메모/문서
ai-workspace/
AGENTS.md
# 코드 전송용 zip 등
*.zip
# 수동 백업본
*.LOCAL_BACKUP
# 서버 측 원본 CSV 데이터/로그
server/data/

# 데모용 더미 CSV — 추적 안 함 (스크립트/메타만 추적)
demo_file/**/*.csv
# 데모 폴더는 자체 .git 가진 중첩 repo(26k+ 파일) — 통째로 추적 제외
demo_file/

# 대용량 빌드 산출물 (capstone2.egg ~3.1GB 등) — 절대 커밋 금지
*.egg
