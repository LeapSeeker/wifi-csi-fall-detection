# .gitignore

# 가상환경
.venv/

# 외부 저장소
esp-csi/
wifi-csi-fall-detection/

# 데이터 & 모델
data/raw/*.csv
data/raw/_archive/
data/augmented/*.csv
model/pretrained/*.pth
model/pretrained/checkpoints/
model/pretrained/checkpoints_local_backup_*/
model/pretrained/*.pt
*.onnx

# Python
__pycache__/
*.pyc

# 빌드
build/

# 에디터
.vscode/
.DS_Store
Thumbs.db

# 개인용 Claude Code 메모리 (팀 공유 안 함)
CLAUDE.local.md

# 개인용 Claude Code 권한/설정 (팀 공유 안 함)
.claude/settings.local.json
.claude/settings.json

# 서버 런타임 로그
server/logs/

# 사전학습 데이터셋 (폴더는 보존, 내용물만 제외)
data/alsaify-raw/*
!data/alsaify-raw/.gitkeep

# 샘플 데이터 (테스트용 zip 등, 폴더는 보존)
data/sample-data/*
!data/sample-data/.gitkeep